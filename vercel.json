{
  "buildCommand": "node scripts/build-extension.mjs",
  "outputDirectory": "public",
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "crons": [{ "path": "/api/tick", "schedule": "17 3 * * *" }],
  "headers": [
    { "source": "/gap133-game.mcpb", "headers": [
      { "key": "Content-Type", "value": "application/octet-stream" },
      { "key": "Content-Disposition", "value": "attachment; filename=\"gap133-game.mcpb\"" } ] }
  ]
}
